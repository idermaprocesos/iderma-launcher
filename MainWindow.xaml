<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Iderma_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Iderma_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Iderma Launcher"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootHost" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Iderma Launcher">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            Background="Transparent" />

        <Border
            x:Name="AnclaGuia"
            Grid.Row="1"
            Width="24"
            Height="24"
            Margin="40,24,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            IsHitTestVisible="False" />

        <TeachingTip
            x:Name="TipGuia"
            Title="Guía de inicio rápido"
            Grid.RowSpan="2"
            ActionButtonClick="TipGuia_ActionButtonClick"
            CloseButtonClick="TipGuia_CloseButtonClick"
            IsLightDismissEnabled="False"
            PreferredPlacement="Bottom">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE897;" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</Window>
