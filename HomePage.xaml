<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Iderma_Launcher.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Iderma_Launcher"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="GridAppTemplate" x:DataType="local:AppCard">
            <Button
                Width="240"
                MinHeight="196"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="AppCard_Click"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                FocusVisualMargin="0"
                IsEnabled="{x:Bind CanLaunch}"
                Tag="{x:Bind Id}">
                <Border
                    Width="240"
                    MinHeight="196"
                    Opacity="{x:Bind CardOpacity}"
                    Style="{StaticResource FluentCardStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Border
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Image Source="{x:Bind LogoPath}" Stretch="UniformToFill" />
                            </Border>
                            <Border
                                Width="22"
                                Height="22"
                                Margin="38,36,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Visibility="{x:Bind LockVisibility}">
                                <FontIcon
                                    FontSize="11"
                                    Glyph="&#xE72E;"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind Name}" />

                        <Border
                            Grid.Row="2"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            Background="{x:Bind StatusBackground}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind StatusForeground}"
                                Text="{x:Bind StatusLabel}" />
                        </Border>

                        <TextBlock
                            Grid.Row="3"
                            MaxLines="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CompactAppTemplate" x:DataType="local:AppCard">
            <Button
                Width="156"
                MinHeight="132"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="AppCard_Click"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                FocusVisualMargin="0"
                IsEnabled="{x:Bind CanLaunch}"
                Tag="{x:Bind Id}">
                <Border
                    Width="156"
                    MinHeight="132"
                    Opacity="{x:Bind CardOpacity}"
                    Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Border
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Image Source="{x:Bind LogoPath}" Stretch="UniformToFill" />
                            </Border>
                            <Border
                                Width="18"
                                Height="18"
                                Margin="26,26,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="{x:Bind LockVisibility}">
                                <FontIcon
                                    FontSize="9"
                                    Glyph="&#xE72E;"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextWrapping="Wrap" />
                        <Border
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            Background="{x:Bind StatusBackground}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind StatusForeground}"
                                Text="{x:Bind StatusLabel}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ListAppTemplate" x:DataType="local:AppCard">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="AppCard_Click"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                FocusVisualMargin="0"
                IsEnabled="{x:Bind CanLaunch}"
                Tag="{x:Bind Id}">
                <Border
                    Opacity="{x:Bind CardOpacity}"
                    Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="44" Height="44">
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Image Source="{x:Bind LogoPath}" Stretch="UniformToFill" />
                            </Border>
                            <Border
                                Width="18"
                                Height="18"
                                Margin="28,28,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="{x:Bind LockVisibility}">
                                <FontIcon
                                    FontSize="9"
                                    Glyph="&#xE72E;"
                                    HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{x:Bind StatusBackground}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind StatusForeground}"
                                Text="{x:Bind StatusLabel}" />
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CompactMeetingTemplate" x:DataType="local:MeetingCard">
            <Border
                Width="300"
                MinHeight="76"
                Padding="12"
                Opacity="{x:Bind CardOpacity}"
                RightTapped="MeetingCard_RightTapped"
                Style="{StaticResource FluentCardStyle}"
                Tag="{x:Bind Id}"
                Tapped="MeetingCard_Tapped"
                ToolTipService.ToolTip="Clic: ver detalle · Clic derecho: sí / no participo">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Image Source="{x:Bind LogoPath}" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind WhenLabel}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationLabel}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind LocationLabel}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="40,16,40,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture
                    x:Name="UserPicture"
                    Width="48"
                    Height="48"
                    IsTabStop="True"
                    Tapped="UserPicture_Tapped"
                    ToolTipService.ToolTip="Ver foto" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="GreetingText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Bienvenido"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Selecciona una aplicación" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    x:Name="UpdateStatusText"
                    Margin="0,16,0,0"
                    MaxWidth="480"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Text="Su aplicación está actualizada"
                    TextAlignment="Right"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <DropDownButton
                    x:Name="ViewButton"
                    VerticalAlignment="Center"
                    Content="Cuadrícula"
                    ToolTipService.ToolTip="Cambiar vista">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem
                                x:Name="ViewGridItem"
                                Click="ViewMenu_Click"
                                GroupName="AppView"
                                IsChecked="True"
                                Tag="grid"
                                Text="Cuadrícula">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE80A;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem
                                x:Name="ViewListItem"
                                Click="ViewMenu_Click"
                                GroupName="AppView"
                                Tag="list"
                                Text="Lista">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem
                                x:Name="ViewCompactItem"
                                Click="ViewMenu_Click"
                                GroupName="AppView"
                                Tag="compact"
                                Text="Compacta">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A9;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <CommandBar
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarButton
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Label="Configuración">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="DownloadAllButton"
                        Click="DownloadAllButton_Click"
                        Label="Descargar todo"
                        ToolTipService.ToolTip="Descarga e instala todas las aplicaciones de su cuenta">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="UpdatesButton"
                        Click="UpdatesButton_Click"
                        Label="Actualizaciones">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE895;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="LogoutButton"
                        Click="LogoutButton_Click"
                        Label="Cerrar sesión">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF3B1;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="UpdateBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="Actualizaciones" />
            <ProgressBar
                x:Name="UpdateProgress"
                Maximum="100"
                Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer
            x:Name="OuterScroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="OuterScroll_SizeChanged"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="ContentLayout"
                ColumnSpacing="20"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideDividerCol" Width="0" />
                    <ColumnDefinition x:Name="SideMeetingsCol" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="StackedMeetingsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="AppsScroll"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0">
                        <GridView
                            x:Name="AppsGrid"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource ChromeLessGridViewItemStyle}"
                            ItemTemplate="{StaticResource GridAppTemplate}"
                            SelectionMode="None">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                        </GridView>
                        <ListView
                            x:Name="AppsList"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource ChromeLessListViewItemStyle}"
                            ItemTemplate="{StaticResource ListAppTemplate}"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <Rectangle
                    x:Name="SideDivider"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="1"
                    VerticalAlignment="Stretch"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed" />

                <Border
                    x:Name="MeetingsHost"
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="0,4,0,0">
                    <ScrollViewer
                        x:Name="MeetingsScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                            <Rectangle
                                x:Name="StackedDivider"
                                Height="1"
                                Margin="0,0,0,4"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Reuniones" />
                                    <TextBlock
                                        x:Name="MeetingsSubtitle"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Próximas reuniones del equipo" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button Click="ScheduleMeeting_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock Text="Programar" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MeetingHistory_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE81C;" />
                                            <TextBlock Text="Historial" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="NoMeetingsText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="No hay reuniones próximas. Programa una con el equipo."
                                Visibility="Collapsed" />

                            <GridView
                                x:Name="MeetingsGrid"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource ChromeLessGridViewItemStyle}"
                                ItemTemplate="{StaticResource CompactMeetingTemplate}"
                                SelectionMode="None">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </GridView.ItemContainerTransitions>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Padding="0,8"
            HorizontalAlignment="Left"
            Background="Transparent"
            Tapped="Footer_Tapped">
            <TextBlock
                x:Name="FooterText"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
