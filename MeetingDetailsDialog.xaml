<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Iderma_Launcher.MeetingDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iderma_Launcher"
    Title="Detalle de la reunión"
    CloseButtonClick="Cerrar_Click"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    PrimaryButtonClick="Editar_Click"
    PrimaryButtonText="Editar">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    </ContentDialog.Resources>

    <Grid
        MinWidth="860"
        MaxHeight="560"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Image
                    x:Name="Icono"
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Left"
                    Stretch="Uniform" />

                <TextBlock
                    x:Name="TituloTexto"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="CuandoTexto"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LugarTexto"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DuracionTexto"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="OrganizadorTexto"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    x:Name="EnlaceBoton"
                    NavigateUri="https://example.com"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Rectangle
            Grid.Column="1"
            Width="1"
            Margin="0,4"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border Grid.Column="2" Padding="4,0,0,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Participantes" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SinPersonas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sin participantes."
                            Visibility="Collapsed" />
                        <ItemsControl x:Name="PersonasLista" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Rectangle
            Grid.Column="3"
            Width="1"
            Margin="0,4"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border Grid.Column="4" Padding="4,0,0,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Objetivos" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SinObjetivos"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sin objetivos."
                            Visibility="Collapsed" />
                        <ItemsControl x:Name="ObjetivosLista">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MeetingObjectiveItem">
                                    <CheckBox
                                        Margin="0,0,0,4"
                                        Content="{x:Bind Text}"
                                        IsChecked="{x:Bind IsDone, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
