<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Iderma_Launcher.MeetingHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iderma_Launcher"
    Title="Historial de reuniones"
    CloseButtonText="Cerrar"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="420" MinHeight="280">
        <TextBlock
            x:Name="VacioTexto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No hay reuniones anteriores."
            Visibility="Collapsed" />
        <ListView
            x:Name="HistorialLista"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MeetingCard">
                    <Border
                        Margin="0,0,0,8"
                        Opacity="{x:Bind CardOpacity}"
                        Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Image Source="{x:Bind LogoPath}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind WhenLabel}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DurationLabel}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LocationLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
