<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Iderma_Launcher.ScheduleMeetingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iderma_Launcher"
    Title="Programar reunión"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Programar">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">780</x:Double>
    </ContentDialog.Resources>

    <Grid
        MinWidth="960"
        MaxHeight="620"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- Columna 1: datos de la reunión -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="ErrorTexto"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Image
                    x:Name="PreviewIcono"
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Left"
                    Stretch="Uniform" />

                <TextBox
                    x:Name="TituloBox"
                    Header="Asunto"
                    PlaceholderText="Reunión de equipo" />

                <ComboBox
                    x:Name="LugarCombo"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    Header="Lugar"
                    SelectionChanged="LugarCombo_SelectionChanged" />

                <CalendarDatePicker
                    x:Name="FechaPicker"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    DateFormat="{}{day.integer} {month.full} {year.full}"
                    Header="Fecha"
                    PlaceholderText="Elige una fecha" />
                <TimePicker
                    x:Name="HoraPicker"
                    MinWidth="0"
                    HorizontalAlignment="Left"
                    ClockIdentifier="24HourClock"
                    Header="Hora"
                    MinuteIncrement="15" />

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Duración" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton
                            x:Name="Duracion30"
                            HorizontalAlignment="Stretch"
                            Checked="Duracion_Checked"
                            Content="30 min"
                            IsChecked="True"
                            Tag="30" />
                        <ToggleButton
                            x:Name="Duracion60"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Checked="Duracion_Checked"
                            Content="1 h"
                            Tag="60" />
                        <ToggleButton
                            x:Name="Duracion90"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Checked="Duracion_Checked"
                            Content="1 h 30"
                            Tag="90" />
                        <ToggleButton
                            x:Name="DuracionLarga"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Checked="Duracion_Checked"
                            Content="Larga"
                            Tag="180" />
                    </Grid>
                </StackPanel>

                <ToggleSwitch
                    x:Name="VirtualSwitch"
                    Header="Teams / Google Meet"
                    OffContent="Presencial"
                    OnContent="Virtual"
                    Toggled="VirtualSwitch_Toggled" />
                <TextBox
                    x:Name="EnlaceBox"
                    Header="Enlace"
                    PlaceholderText="https://teams.microsoft.com/..."
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Rectangle
            Grid.Column="1"
            Width="1"
            Margin="0,4"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Columna 2: participantes -->
        <Border Grid.Column="2" Padding="4,0,0,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Participantes" />
                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Personas de la app Cuentas"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PersonaCombo"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Elegir persona" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="AgregarPersona_Click"
                        Content="Agregar" />
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SinPersonas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Todavía no hay participantes." />
                        <ItemsControl x:Name="PersonasLista">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MeetingPersonItem">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="1"
                                            Click="QuitarPersona_Click"
                                            Content="Quitar"
                                            Tag="{x:Bind UserId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Rectangle
            Grid.Column="3"
            Width="1"
            Margin="0,4"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Columna 3: objetivos -->
        <Border Grid.Column="4" Padding="4,0,0,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Objetivos" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ObjetivoBox"
                        MinWidth="0"
                        PlaceholderText="Nuevo objetivo" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="AgregarObjetivo_Click"
                        Content="Agregar" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="SinObjetivos"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Todavía no hay objetivos." />
                        <ItemsControl x:Name="ObjetivosLista">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MeetingObjectiveItem">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Content="{x:Bind Text}"
                                            IsChecked="{x:Bind IsDone, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="QuitarObjetivo_Click"
                                            Content="Quitar"
                                            Tag="{x:Bind Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
