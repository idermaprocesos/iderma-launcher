<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Iderma_Launcher.ArcadeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Arcade">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="Transparent"
        PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Arcade" />

        <Grid
            Grid.Row="1"
            Padding="24,8,24,20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="MinesTabButton"
                    Click="MinesTab_Click"
                    Content="Buscaminas"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="SnakeTabButton"
                    Click="SnakeTab_Click"
                    Content="Snake" />
            </StackPanel>

            <Grid x:Name="MinesPanel" Grid.Row="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="MineFaceButton"
                        Width="48"
                        Height="40"
                        Click="MineFace_Click"
                        Content="🙂"
                        FontSize="20"
                        ToolTipService.ToolTip="Nueva partida" />

                    <ComboBox
                        x:Name="MineDifficulty"
                        Grid.Column="1"
                        Width="180"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="MineDifficulty_SelectionChanged">
                        <ComboBoxItem Content="Fácil · 9×9" />
                        <ComboBoxItem Content="Medio · 16×16" />
                        <ComboBoxItem Content="Difícil · 16×30" />
                    </ComboBox>

                    <TextBlock
                        x:Name="MineCountText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Minas: 10" />
                    <TextBlock
                        x:Name="MineTimeText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Text="Tiempo: 00:00" />
                    <TextBlock
                        x:Name="MineStatusText"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Clic izquierdo descubre. Clic derecho pone una bandera. Si un número ya tiene sus banderas, otro clic abre el alrededor."
                    TextWrapping="Wrap" />

                <Viewbox
                    Grid.Row="2"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <Border
                        Padding="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF141418"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid x:Name="MineBoard" />
                    </Border>
                </Viewbox>
            </Grid>

            <Grid
                x:Name="SnakePanel"
                Grid.Row="1"
                RowSpacing="10"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="SnakeDifficulty"
                        Width="140"
                        VerticalAlignment="Center"
                        SelectedIndex="1"
                        SelectionChanged="SnakeDifficulty_SelectionChanged">
                        <ComboBoxItem Content="Lento" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Rápido" />
                    </ComboBox>

                    <TextBlock
                        x:Name="SnakeScoreText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Puntos: 0" />
                    <TextBlock
                        x:Name="SnakeBestText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="Récord: 0" />
                    <Button 
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Click="SnakeRestart_Click"
                        Content="Nueva partida" />
                </Grid>

                <TextBlock
                    x:Name="SnakeHint"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pulsa una flecha o WASD para empezar." />

                <Viewbox
                    Grid.Row="2"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border
                            x:Name="SnakeBoard"
                            Padding="8"
                            Background="#FF141418"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid x:Name="SnakeGrid" />
                        </Border>
                        <Border
                            x:Name="SnakeOverlay"
                            Background="#D0101014"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <TextBlock
                                    x:Name="SnakeOverlayTitle"
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                                <TextBlock
                                    x:Name="SnakeOverlayText"
                                    HorizontalAlignment="Center"
                                    Foreground="#FFE6E8EE"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="SnakeOverlayButton"
                                    HorizontalAlignment="Center"
                                    Click="SnakeOverlayButton_Click"
                                    Content="Jugar otra vez" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</Window>
